    {
      "parameters": {
        "promptType": "define",
        "text": "=STUDENT PROFILE\nFull Name: {{ $('CareerPilot Student Form').first().json['Full Name'] }}\nEducation: {{ $('CareerPilot Student Form').first().json['Current Education'] }}\nExisting Skills: {{ $('CareerPilot Student Form').first().json['Existing Skills'] }}\nExperience/Projects: {{ $('CareerPilot Student Form').first().json['Experience / Projects'] }}\nTarget Role: {{ $('CareerPilot Student Form').first().json['Target Career Role'] }}\nExperience Level: {{ $('CareerPilot Student Form').first().json['Current Experience Level'] }}\nWeekly Hours: {{ $('CareerPilot Student Form').first().json['Weekly Learning Hours'] }}\nCareer Goal: {{ $('CareerPilot Student Form').first().json['Career Goal'] }}",
        "options": {
          "systemMessage": "Role: Student Skills Analyst. Classify self-reported skills vs demonstrably evidenced projects vs merely inferred/unverified capability; academic level; strengths and uncertainties. Never invent completed technical work, professional experience or soft skills. A task app does not prove backend or database. Maximum 350 words.",
          "maxIterations": 1,
          "returnIntermediateSteps": false
        }
      },
      "id": "433b7efd-0608-4c9b-9333-0a5763604537",
      "name": "Skills Analyst",
