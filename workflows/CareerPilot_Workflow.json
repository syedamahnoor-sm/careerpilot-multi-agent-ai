        "promptType": "define",
        "text": "=SKILLS: {{ $('CareerPilot Student Form').first().json['Existing Skills'] }}\nPROJECTS: {{ $('CareerPilot Student Form').first().json['Experience / Projects'] }}\nCAREER TARGET: {{ $('CareerPilot Student Form').first().json['Target Career Role'] }}\nSKILLS ANALYST:\n{{ $('Skills Analyst').first().json.output }}\nCAREER RESEARCHER:\n{{ $('Career Research Agent').first().json.output }}",
        "options": {
