        "text": "=STUDENT NAME: {{ $('CareerPilot Student Form').first().json['Full Name'] }}\nSKILLS: {{ $('CareerPilot Student Form').first().json['Existing Skills'] }}\nPROJECTS: {{ $('CareerPilot Student Form').first().json['Experience / Projects'] }}\nTARGET: {{ $('CareerPilot Student Form').first().json['Target Career Role'] }}\nEXPERIENCE: {{ $('CareerPilot Student Form').first().json['Current Experience Level'] }}\nHARD WEEKLY HOURS LIMIT: {{ $('CareerPilot Student Form').first().json['Weekly Learning Hours'] }}\nGOAL: {{ $('CareerPilot Student Form').first().json['Career Goal'] }}\nPRIORITIZED SKILL GAPS:\n{{ $('Skill Gap Analyst').first().json.output }}",
