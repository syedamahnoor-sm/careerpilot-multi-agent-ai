    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=TARGET: {{ $('CareerPilot Student Form').first().json['Target Career Role'] }}\nLEVEL: {{ $('CareerPilot Student Form').first().json['Current Experience Level'] }}\nSKILLS EVIDENCE:\n{{ $('Skills Analyst').first().json.output }}",
        "options": {
          "systemMessage": "Role: Career Researcher. Use GENERAL career knowledge only, not live research. Explain essential and optional entry-level role competencies, sensible technology choices and requirements. No fabricated salaries, job postings, statistics or market evidence. Learning one database well is sufficient as a starting point. Maximum 350 words.",
          "maxIterations": 1,
          "returnIntermediateSteps": false
        }
      },
